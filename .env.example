# Environment variables — copy this file to .env and fill in your real values
# NEVER commit .env to version control

# GitHub webhook secret — must match the secret you set in GitHub repo → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=

# GitHub personal access token (or GitHub App token) with repo scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Gemini API key
# Create at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Port the Express server listens on (Render sets this automatically — leave blank locally to use 3000)
PORT=3000

# PostgreSQL connection string (only needed if you implement the optional database milestone M7)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_review_bot
